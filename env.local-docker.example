# Example connection strings for host-run Nest/Next against docker deps.
# Copy the keys you need into your local .env (never commit real secrets).
#
# After: npm run docker:local:deps

DATABASE_URL=postgresql://archaser:archaser@127.0.0.1:5432/archaser?schema=public
MONGODB_URI=mongodb://127.0.0.1:27017/archaser_local
REDIS_URL=redis://127.0.0.1:6379

# Optional port overrides for docker-compose.local-dev.yml
# LOCAL_POSTGRES_PORT=5432
# LOCAL_MONGO_PORT=27017
# LOCAL_REDIS_PORT=6379
# LOCAL_POSTGRES_USER=archaser
# LOCAL_POSTGRES_PASSWORD=archaser
# LOCAL_POSTGRES_DB=archaser
# LOCAL_MONGO_DB=archaser_local
