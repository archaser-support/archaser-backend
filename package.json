{
  "name": "archaser-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Archaser backend workspace (Nest services). Becomes its own git repo.",
  "workspaces": [
    "api",
    "worker",
    "sms",
    "connectors",
    "reports",
    "packages/database",
    "packages/openapi-client",
    "packages/sms-send",
    "packages/auth",
    "packages/credit-insurance-domain",
    "packages/billing-connector",
    "packages/cron-jobs"
  ],
  "overrides": {
    "esbuild": "0.25.0",
    "nodemailer": "9.0.6",
    "deepmerge-ts": "8.0.2",
    "postcss": "8.5.26",
    "@nestjs/swagger": {
      "js-yaml": "5.4.1"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "setup": "prisma generate --schema=./prisma/schema.prisma && node ./scripts/sync-prisma-client.js",
    "dev:all": "bash ./scripts/startup/dev-microservices.sh",
    "dev:api": "npm run start:dev -w @archaser/api",
    "start:api": "npm run start:prod -w @archaser/api",
    "build:api": "npm run build -w @archaser/database && npm run build -w @archaser/api",
    "build:database": "npm run build -w @archaser/database",
    "build:sms-send": "npm run build -w @archaser/sms-send",
    "build:auth": "npm run build -w @archaser/auth",
    "build:credit-insurance-domain": "npm run build -w @archaser/credit-insurance-domain",
    "check:credit-insurance-domain-leaf": "npm run check:leaf -w @archaser/credit-insurance-domain",
    "test:sms-send": "npm run test -w @archaser/sms-send",
    "test:api": "npm run test -w @archaser/api",
    "dev:worker": "npm run start:dev -w @archaser/worker",
    "dev:sms": "npm run start:dev -w @archaser/sms",
    "dev:connectors": "npm run start:dev -w @archaser/connectors",
    "dev:reports": "npm run start:dev -w @archaser/reports",
    "soak:check": "npx tsx ./scripts/soak/check-soak-readiness.ts",
    "soak:check:worker": "npx tsx ./scripts/soak/check-soak-readiness.ts --worker-url http://127.0.0.1:3003",
    "soak:sms-contract": "npm run test -w @archaser/sms",
    "soak:cron-registry": "npm run test -w @archaser/cron-jobs",
    "openapi:export": "npm run build -w @archaser/api && npx tsx ./scripts/openapi/export-nest-openapi.ts",
    "deploy:docker:staging": "bash ./scripts/deployment/deploy-backend-docker.sh --env staging",
    "deploy:docker:production": "bash ./scripts/deployment/deploy-backend-docker.sh --env production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:activity-keys": "npx tsx scripts/database/run-migration.ts",
    "migrate:activity-keys:dry": "npx tsx scripts/database/run-migration.ts --dry-run",
    "check:currency-fallbacks": "node scripts/check-currency-fallbacks.js"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "husky": "^8.0.0",
    "prettier": "^3.0.0",
    "prisma": "^6.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  }
}
