# EndlessScrollDataGrid Usage

## Summary

This document provides comprehensive guidelines for using the `EndlessScrollDataGrid` component, a virtual scrolling grid with infinite scroll capabilities. It covers:

- **Critical Requirements**: Mandatory search and sorting implementation, debounced search, stable row IDs
- **GET Endpoints**: Using `createQueryFn` helper for fetch-based requests
- **POST Endpoints**: Handling POST requests with search and sorting
- **Column Configuration**: Field definitions, renderers, formatters, and RTL support
- **Virtual Scrolling**: Performance optimization with stable IDs and proper row height
- **State Management**: Search, sorting, filtering, and pagination state handling
- **RTL Support**: Right-to-left layout for Hebrew language

## 📊 EndlessScrollDataGrid Usage

### ⚠️ Critical Requirements

**ALWAYS implement search and sorting when using `EndlessScrollDataGrid`:**

- ✅ **Search**: Provide `searchValue`, `onSearchChange`, `searchPlaceholder` props
- ✅ **Sorting**: Provide `sortModel` and `onSortModelChange` props
- ✅ **Debounced Search**: Use `useDebounce` hook (500ms standard)
- ✅ **Query Integration**: Include search and sort in query key and API parameters
- ✅ **Stable Row IDs**: Every row must have a stable `id` field for virtual scrolling

### GET Endpoints (Recommended Pattern)

**ALWAYS use `createQueryFn` helper for fetch-based GET requests:**

```typescript
import { useVirtualInfiniteScroll, createQueryFn } from "@/shared/layout-components/grid/EndlessScrollDataGrid";
import { useState, useMemo } from "react";
import { useDebounce } from "use-debounce";
import { GridSortModel } from "@mui/x-data-grid";

// State setup
const [search, setSearch] = useState("");
const [debouncedSearch] = useDebounce(search, 500);
const [sortModel, setSortModel] = useState<GridSortModel>([{ field: "name", sort: "asc" }]);
const [queryKeyVersion, setQueryKeyVersion] = useState(0);

const sortField = sortModel[0]?.field;
const sortDirection = sortModel[0]?.sort;

// Query key - all parameters in a single object
const queryKey = useMemo(
    () => [
        "your-entity-name",
        {
            search: debouncedSearch,
            filter: filterValue,
            status: statusFilter,
            sortField,
            sortDirection,
            version: queryKeyVersion,
        },
    ],
    [debouncedSearch, filterValue, statusFilter, sortField, sortDirection, queryKeyVersion]
);

// Use createQueryFn for fetch-based GET requests
const { data, totalRecords, isLoading, hasMore, loadMore, reset } = useVirtualInfiniteScroll({
    queryKey,
    queryFn: createQueryFn(
        "/api/your-endpoint",
        {
            search: debouncedSearch,
            filter: filterValue,
            status: statusFilter,
            sortField: sortField || "",
            sortDirection: sortDirection || "asc",
        },
        "dataKey" // Response key containing data array (e.g., "customers", "data", "results")
    ),
});

// Grid component
<EndlessScrollDataGrid
    key={`${entityId}-${debouncedSearch}-${queryKeyVersion}`}
    rows={rows}
    columns={columns}
    totalRecords={totalRecords}
    isLoading={isLoading}
    onLoadMore={loadMore}
    hasMore={hasMore}
    sortModel={sortModel}
    onSortModelChange={setSortModel}
    searchValue={search}
    onSearchChange={setSearch}
    searchPlaceholder={t("fields.search_placeholder", { ns: "common" })}
    searchDebounceMs={500}
    searchDirection={i18n.language === "he" ? "rtl" : "ltr"}
    language={i18n.language}
    fillViewport={true}
/>
```

**Key Points:**
- ✅ Query key structure: `["entity-name", { param1, param2, ... }]` - single object as second element
- ✅ `createQueryFn` handles query params, pagination, and response parsing automatically
- ✅ Third parameter is the data key in API response
- ✅ Default page size is **20 records** (not configurable)
- ✅ Include `queryKeyVersion` in query key and grid `key` prop

### API-Based GET Endpoints (Alternative Pattern)

**Use `createApiQueryFn` helper for API-based GET requests (using `api.get`):**

```typescript
import { useVirtualInfiniteScroll, createApiQueryFn } from "@/shared/layout-components/grid/EndlessScrollDataGrid";
import { useState, useMemo } from "react";
import { useDebounce } from "use-debounce";
import { GridSortModel } from "@mui/x-data-grid";
import api from "@/app/api";

// State setup (same as above)
const [search, setSearch] = useState("");
const [debouncedSearch] = useDebounce(search, 500);
const [sortModel, setSortModel] = useState<GridSortModel>([{ field: "name", sort: "asc" }]);
const [queryKeyVersion, setQueryKeyVersion] = useState(0);

const sortField = sortModel[0]?.field;
const sortDirection = sortModel[0]?.sort;

// Query key (same pattern)
const queryKey = useMemo(
    () => [
        "your-entity-name",
        {
            search: debouncedSearch,
            filter: filterValue,
            status: statusFilter,
            sortField,
            sortDirection,
            version: queryKeyVersion,
        },
    ],
    [debouncedSearch, filterValue, statusFilter, sortField, sortDirection, queryKeyVersion]
);

// Use createApiQueryFn for API-based GET requests
const queryFn = useMemo(
    () =>
        createApiQueryFn(
            async (params: any) => {
                const queryParams = new URLSearchParams();
                queryParams.append("page", params.page.toString());
                queryParams.append("limit", params.limit.toString());
                if (params.sortField) queryParams.append("sortField", params.sortField);
                if (params.sortDirection) queryParams.append("sortDirection", params.sortDirection);
                if (params.search) queryParams.append("query", params.search);
                if (params.status) queryParams.append("status", params.status);

                const response = await api.get(`/your-endpoint?${queryParams.toString()}`);
                return response.data;
            },
            {
                search: debouncedSearch,
                status: filterValue,
                sortField: sortField || "",
                sortDirection: sortDirection || "asc",
            },
            "dataKey", // Response key containing data array
            "totalRecords" // Response key containing total count (default: "totalRecords")
        ),
    [debouncedSearch, filterValue, sortField, sortDirection]
);

const { data, totalRecords, isLoading, hasMore, loadMore, reset } = useVirtualInfiniteScroll({
    queryKey,
    queryFn,
});
```

**Key Points:**
- ✅ Use `createApiQueryFn` when using `api.get` instead of `fetch`
- ✅ First parameter is the API call function that receives params
- ✅ Second parameter is the params object (will be filtered for empty values)
- ✅ Third parameter is the data key in API response (default: "data")
- ✅ Fourth parameter is the total records key (default: "totalRecords")
- ✅ Default page size is **20 records** (not configurable)

### POST Endpoints (Custom Implementation)

**Only use custom `queryFn` when POST is required:**

```typescript
// Query key - same pattern as GET
const queryKey = useMemo(
    () => [
        "your-entity-name",
        {
            entityId,
            search: debouncedSearch,
            sortField,
            sortDirection,
            version: queryKeyVersion,
        },
    ],
    [entityId, debouncedSearch, sortField, sortDirection, queryKeyVersion]
);

// Custom queryFn for POST - use useCallback (it's a function)
const executeQueryFn = useCallback(
    async (page: number = 1) => {
        const response = await fetch(`/api/your-endpoint/${entityId}/execute`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                page,
                limit: 20, // Default page size is 20
                search: debouncedSearch,
                sortField,
                sortDirection,
            }),
        });

        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }

        const data = await response.json();
        const limit = 20; // Default page size is 20
        const returnedData = data.data || [];
        const total = data.totalRecords || 0;

        return {
            data: returnedData,
            totalRecords: total,
            hasMore: returnedData.length > 0 && (page * limit) < total,
        };
    },
    [entityId, debouncedSearch, sortField, sortDirection] // Include all dependencies
);

const { data, totalRecords, isLoading, hasMore, loadMore, reset } = useVirtualInfiniteScroll({
    queryKey,
    queryFn: executeQueryFn,
});
```

**Key Points:**
- ⚠️ Only use custom `queryFn` when POST is required
- ✅ Use `useCallback` for query functions (not `useMemo`)
- ✅ Include all dependencies in dependency array
- ✅ Default page size is **20 records** (use `limit: 20` in POST body)
- ✅ Accurate `hasMore`: `returnedData.length > 0 && (page * limit) < total`
- ✅ Return structure: `{ data: T[], totalRecords: number, hasMore: boolean }`

### Reset Logic Pattern

**Prevent unnecessary resets on initial mount:**

```typescript
const prevDebouncedSearchRef = useRef(debouncedSearch);
const prevFilterRef = useRef(filterValue);

React.useEffect(() => {
    const searchChanged = prevDebouncedSearchRef.current !== debouncedSearch;
    const filterChanged = prevFilterRef.current !== filterValue;

    if (searchChanged || filterChanged) {
        prevDebouncedSearchRef.current = debouncedSearch;
        prevFilterRef.current = filterValue;

        // Increment version to force new query
        setQueryKeyVersion((prev) => prev + 1);
        reset();
    }
}, [debouncedSearch, filterValue, reset]);
```

**When to increment `queryKeyVersion`:**
- ✅ When filters/search change (in reset effect)
- ✅ After data mutations (mass updates, creates, updates, deletes)

### Data Transformation Pattern

**Transform API data to grid row format:**

```typescript
// Transformation function - use useCallback
const mapEntityToRow = useCallback((entity: any) => {
    const firstName = getNestedValue(entity, "Person.first_name") || "";
    const lastName = getNestedValue(entity, "Person.last_name") || "";
    const name = `${firstName} ${lastName}`.trim();

    const collectionPeriod = Array.isArray(entity?.CustomerCollectionPeriod)
        ? entity.CustomerCollectionPeriod[0]
        : null;

    const amount = collectionPeriod?.total_outstanding_amount ?? 0;
    const currency = collectionPeriod?.currency ?? "";

    return {
        id: entity.id, // CRITICAL: Stable ID required for virtual scrolling
        name: name || `Entity ${entity.id}`,
        amount_formatted: amount === 0
            ? `0.00 ${currency}`
            : `${formatAmountWithoutSymbol(amount)} ${currency}`,
        amount: amount, // Raw value for sorting/export
        raw: entity, // Original entity for nested data access
    };
}, []);

// Transform rows - use useMemo
const rows = useMemo(() => {
    return entities.map(mapEntityToRow);
}, [entities, mapEntityToRow]);
```

**Key Points:**
- ✅ Use `useCallback` for transformation function
- ✅ Use `useMemo` for transformed rows array
- ✅ **CRITICAL**: Every row must have stable `id` field
- ✅ If API doesn't return `id`, generate stable one: `id: row.id || \`entity-${entityId}-row-${index}\``
- ✅ Include both formatted (display) and raw (sorting/export) values
- ✅ Include `raw` property with original entity
- ✅ **Backend**: Always include `id` field in API responses

### Client-Side Sorting Pattern

**Handle fields that can't be sorted on the server:**

```typescript
const sortedRows = useMemo(() => {
    const needsClientSorting =
        sortField === "no_of_overdue_invoices" ||
        sortField === "total_outstanding_amount" ||
        sortField === "current_category" ||
        sortField === "collection_status";

    if (!needsClientSorting || !sortField || !sortDirection) {
        return rows;
    }

    return [...rows].sort((a, b) => {
        if (sortField === "current_category") {
            const comparison = (a[sortField] ?? "").localeCompare(b[sortField] ?? "");
            return sortDirection === "asc" ? comparison : -comparison;
        } else if (sortField === "collection_status") {
            // Active first logic
            if (a[sortField] === "Active" && b[sortField] !== "Active") {
                return sortDirection === "asc" ? -1 : 1;
            }
            if (a[sortField] !== "Active" && b[sortField] === "Active") {
                return sortDirection === "asc" ? 1 : -1;
            }
            return (a[sortField] ?? "").localeCompare(b[sortField] ?? "");
        } else {
            // Numeric comparison
            return sortDirection === "asc"
                ? (a[sortField] ?? 0) - (b[sortField] ?? 0)
                : (b[sortField] ?? 0) - (a[sortField] ?? 0);
        }
    });
}, [rows, sortField, sortDirection]);
```

### Export Functionality Pattern

```typescript
const handleExport = useCallback(async () => {
    const params = new URLSearchParams({
        search: debouncedSearch,
        filter: filterValue,
        status: statusFilter,
        sortField: sortField || "",
        sortDirection: sortDirection || "asc",
        export: "true",
        limit: "10000",
    });

    const response = await fetch(`/api/your-endpoint?${params.toString()}`);
    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

    const data = await response.json();
    const rawEntities = data.entities || [];

    // Apply same transformation as grid rows
    return rawEntities.map((entity: any) => ({
        id: entity.id,
        name: name || `Entity ${entity.id}`,
        amount: formatCurrencyWithCode(amount, currency),
        raw: entity,
    }));
}, [debouncedSearch, filterValue, statusFilter, sortField, sortDirection]);

<EndlessScrollDataGrid
    onExport={handleExport}
    exportContextInfo={{
        pageName: "your-page-name",
        customPrefix: "your_export_prefix",
    }}
    currencyColumns={{
        total_outstanding_amount: {
            amountField: "total_outstanding_amount_value",
            currencyField: "total_outstanding_amount_currency",
        },
    } as CurrencyColumnsConfig}
/>
```

