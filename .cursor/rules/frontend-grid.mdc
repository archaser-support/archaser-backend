### Row Selection Pattern

```typescript
const [selectedRows, setSelectedRows] = useState<number[]>([]);

const columns: GridColDef[] = [
    {
        field: "checkbox",
        headerName: "",
        width: 40, // Grid automatically reduces to 40px if specified
        minWidth: 40,
        maxWidth: 40,
        sortable: false,
        filterable: false,
        disableColumnMenu: true,
        resizable: false,
        renderCell: (params: GridRenderCellParams) => (
            <Box
                onClick={(e) => {
                    e.preventDefault();
                    e.stopPropagation();
                }}
                sx={{ display: "flex", alignItems: "center", justifyContent: "center", height: "100%", width: "100%", cursor: "default" }}
            >
                <Checkbox
                    checked={selectedRows.includes(params.row.id)}
                    onChange={(e) => {
                        e.stopPropagation();
                        if (e.target.checked) {
                            setSelectedRows((prev) => [...prev, params.row.id]);
                        } else {
                            setSelectedRows((prev) => prev.filter((id) => id !== params.row.id));
                        }
                    }}
                    onClick={(e) => e.stopPropagation()}
                    sx={{ padding: 0, color: theme.palette.primary.main, "&.Mui-checked": { color: theme.palette.primary.main } }}
                />
            </Box>
        ),
    },
];
```

**Key Points:**
- ✅ Grid automatically reduces checkbox column width to 40px if present
- ✅ Checkbox column is positioned before row number column
- ✅ Use `width: 40, minWidth: 40, maxWidth: 40` for consistency

### Custom Toolbar Buttons

**⚠️ IMPORTANT: Toolbar buttons must be icon-only - NO text labels**

- ✅ Use `IconButton` component (not `Button` with text)
- ✅ Icon only - tooltip provides the label text
- ✅ Use proper Tooltip with RTL support (see [Tooltip Styling](./frontend-tooltips.mdc))
- ✅ Apply primary color with subtle hover background
- ✅ Use square hover: `borderRadius: 2` (not round/circular)
- ✅ **PRESERVE original icons** - When converting from `Button` to `IconButton`, keep the existing icon (don't replace it)

```typescript
import { IconButton, Tooltip, Badge, Box } from "@mui/material";
import { useTheme, alpha } from "@mui/material/styles";
import { PostAdd, MoreVert } from "@mui/icons-material";
import { useTranslation } from "react-i18next";

const FilterComponent = () => {
    const { t, i18n } = useTranslation(["common"]);
    const theme = useTheme();
    
    return (
    <Box sx={{ display: "flex", gap: theme.spacing(2), alignItems: "center", direction: i18n.language === "he" ? "rtl" : "ltr" }}>
        <ToolbarDropdownFilter<FilterOption>
            value={currentValue}
            onChange={(newValue) => setFilterStatus(newValue?.value as FilterType)}
            options={filterOptions}
            getOptionLabel={(option) => option.label}
            isOptionEqualToValue={(option, value) => option.value === value.value}
            placeholder={t("values.status_filter")}
        />
        {selectedRows.length > 0 && (
            <Tooltip 
                title={t("actions.bulk_actions", { ns: "common" })} 
                arrow 
                enterDelay={300}
                leaveDelay={100}
                placement={i18n.language === "he" ? "left" : "right"}
                PopperProps={{
                    sx: {
                        "& .MuiTooltip-tooltip": {
                            direction: i18n.language === "he" ? "rtl" : "ltr",
                        },
                        "& .MuiTooltip-arrow": {
                            ...(i18n.language === "he" && { transform: "scaleX(-1)" }),
                        },
                    },
                }}
            >
                <Badge badgeContent={selectedRows.length} color="primary">
                    <IconButton 
                        color="primary" 
                        onClick={handleActionsMenuOpen}
                        className="toolbar-button"
                    >
                        <MoreVert />
                    </IconButton>
                </Badge>
            </Tooltip>
        )}
        {hasCreatePermission && (
            <Tooltip
                title={t("actions.create")}
                arrow
                enterDelay={300}
                leaveDelay={100}
                placement={i18n.language === "he" ? "left" : "right"}
                PopperProps={{
                    sx: {
                        "& .MuiTooltip-tooltip": {
                            direction: i18n.language === "he" ? "rtl" : "ltr",
                        },
                        "& .MuiTooltip-arrow": {
                            ...(i18n.language === "he" && { transform: "scaleX(-1)" }),
                        },
                    },
                }}
            >
                <IconButton
                    color="primary"
                    size="small"
                    onClick={handleCreate}
                    className="toolbar-button"
                >
                    {/* Use appropriate icon for the action - e.g., PostAdd, PersonAdd, or custom icon overlays */}
                    <PostAdd />
                </IconButton>
            </Tooltip>
        )}
    </Box>
    );
};

<EndlessScrollDataGrid customButtons={<FilterComponent />} />
```

**Key Points:**
- ✅ Always use `IconButton` (not `Button` with text)
- ✅ Icon only - tooltip shows the action label
- ✅ Use `color="primary"` for icon color
- ✅ Use `size="small"` to match toolbar height (32px button in 42px toolbar)
- ✅ Use `className="toolbar-button"` to apply theme styles (square hover, primary color, subtle hover background)
- ✅ Always wrap in Tooltip with proper RTL support
- ✅ **KEEP original icons** - When converting from `Button` to `IconButton`, preserve the existing icon (e.g., `PersonAdd`, `AccountBalanceIcon` with `AddIcon` overlay, `DescriptionIcon` with `AddIcon` overlay, etc.)
- ❌ **NEVER** add text labels to toolbar buttons
- ❌ **NEVER** use inline `sx` styles for toolbar buttons - use the theme class instead
- ❌ **NEVER** replace existing icons when applying toolbar button styles - only apply the styling changes

### Loading States

**The hook provides `isLoadingMore` state for loading indicators:**

```typescript
const { data, totalRecords, isLoading, isLoadingMore, hasMore, loadMore, reset } = useVirtualInfiniteScroll({
    queryKey,
    queryFn,
});

// Grid automatically shows loading indicator at bottom when loading more
// You can also use isLoadingMore for custom loading states
{isLoadingMore && (
    <Box sx={{ display: "flex", justifyContent: "center", py: 2 }}>
        <CircularProgress size={24} />
    </Box>
)}
```

**Key Points:**
- ✅ `isLoading`: true when loading initial data (first page)
- ✅ `isLoadingMore`: true when loading additional pages
- ✅ Grid automatically shows loading indicator at bottom when `isLoadingMore` is true
- ✅ Use `isLoading` to show full-page loading state when `rows.length === 0`

