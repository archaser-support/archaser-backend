  backfill_import_batch_size        Int                     @default(20)
  consecutive_auth_failures         Int                     @default(0)
  backfill_started_at               DateTime?               @db.Timestamptz(6)
  /// Optional cutover calendar day (UTC). Null = full-history backfill.
  backfill_start_date               DateTime?               @db.Date
  /// Optional UTC calendar day; invoices issued before it are out of scope for MEP breach. Null = no gate.
  mep_breach_start_date             DateTime?               @db.Date
  /// When start date is set: also pull unpaid pre-date invoices + related payments.
  include_older_open_invoices       Boolean                 @default(true)
  /// When true, backfill invoice writes do not stamp reporting_breach (incremental/cron unchanged).
  skip_reporting_breach_on_backfill Boolean                 @default(false)
  /// Per-entity Priority EntitySet name overrides (JSON object).
  entity_sets                       Json                    @default("{}")
  /// Cached EntitySet catalog from the ERP.
  entity_set_catalog                Json?
  entity_set_catalog_fetched_at     DateTime?               @db.Timestamptz(6)
  /// Per-entity pull filters (OData / rule builder).
  pull_filters                      Json                    @default("{}")
  pull_filters_cleanup_pending      Boolean                 @default(false)
  pull_filters_cleanup_entities     Json                    @default("[]")
  /// Per-entity preview go/no-go pass flags.
  preview_passes                    Json                    @default("{}")
  /// Optional account-extension plugin key (registry). Null/empty = standard sync path.
  extension_key                     String?                 @db.VarChar(100)
  /// Plugin-owned settings JSON for the attached extension.
  extension_config                  Json?
  last_connection_test_at           DateTime?               @db.Timestamptz(6)
  last_connection_error             String?                 @db.VarChar(500)
  created_at                        DateTime                @default(now()) @db.Timestamptz(6)
  modified_at                       DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  created_by                        String?                 @db.VarChar
  modified_by                       String?                 @db.VarChar
  Account                           Account                 @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ConnectorFieldMapping             ConnectorFieldMapping[]
  ConnectorSyncState                ConnectorSyncState[]

  @@index([account_id], map: "idx_billing_connector_account_id")
  @@index([status], map: "idx_billing_connector_status")
}

model ConnectorFieldMapping {
  id                        Int              @id @default(autoincrement())
  connector_id              Int
  import_type               ImportType
  mapping                   Json
  is_complete               Boolean          @default(false)
  /// Optional OData date column for backfill/incremental window filters.
  pull_date_field           String?          @db.VarChar(100)
  discovered_headers        Json?
  discovered_example_values Json?
  discovered_sample_count   Int?
  discovered_at             DateTime?        @db.Timestamptz(6)
  modified_at               DateTime         @default(now()) @db.Timestamptz(6)
  modified_by               String?          @db.VarChar
  BillingConnector          BillingConnector @relation(fields: [connector_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([connector_id, import_type], map: "unique_connector_field_mapping")
  @@index([connector_id], map: "idx_connector_field_mapping_connector_id")
}

model ConnectorSyncState {
  id                          Int              @id @default(autoincrement())
  connector_id                Int
  entity_type                 ImportType
  backfill_completed          Boolean          @default(false)
  backfill_completed_at       DateTime?        @db.Timestamptz(6)
  backfill_cursor             String?          @db.VarChar(500)
  backfill_records_pulled     Int              @default(0)
  backfill_last_checkpoint_at DateTime?        @db.Timestamptz(6)
  backfill_window_end         DateTime?        @db.Timestamptz(6)
  backfill_total_records      Int?
  last_max_updated_at         DateTime?        @db.Timestamptz(6)
  last_successful_run_at      DateTime?        @db.Timestamptz(6)
  last_attempt_at             DateTime?        @db.Timestamptz(6)
  last_error                  String?          @db.VarChar(500)
  BillingConnector            BillingConnector @relation(fields: [connector_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([connector_id, entity_type], map: "unique_connector_entity_sync_state")
  @@index([connector_id], map: "idx_connector_sync_state_connector_id")
}
