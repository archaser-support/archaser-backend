/// Coalesced as-of rewrite queue (invoice/payment/policy/top-up → overnight CPT drain).
/// One pending row per account is widened/unioned by enqueue; drained by CPT cron.
model CreditAsOfRewriteQueue {
  id              BigInt    @id @default(autoincrement())
  account_id      Int
  customer_ids    Int[]     @default([])
  from_date       DateTime  @db.Date
  to_date         DateTime  @db.Date
  checkpoint_date DateTime? @db.Date
  status          String    @default("pending") @db.VarChar(16)
  attempts        Int       @default(0)
  last_error      String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, account_id], map: "idx_credit_asof_rewrite_queue_status_account")
}

/// Customers whose AR post-ingest refresh failed mid-import. The orchestrator
/// swallows step failures so ingest still succeeds, which used to leave stale
/// capacity gaps with no record; one row per customer is enqueued here instead
/// and retried by the overnight drain.
model ArPostIngestRetryQueue {
  id          BigInt   @id @default(autoincrement())
  account_id  Int
  customer_id Int
  /// Orchestrator steps that failed, e.g. ["replay", "live_refresh"].
  steps       String[] @default([])
  status      String   @default("pending") @db.VarChar(16)
  attempts    Int      @default(0)
  last_error  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([account_id, customer_id], map: "uniq_ar_post_ingest_retry_account_customer")
  @@index([status, account_id], map: "idx_ar_post_ingest_retry_status_account")
}

/// Admin-driven full-history as-of backfill job (one per target account).
/// Drives a day-by-day recompute of CustomerPolicyTrend + CreditDashboardDailySnapshot
/// with pause/resume via `status` and per-day `checkpoint_date`. Overnight drain
/// skips accounts while status is `running` or `paused`.
model CreditAsOfBackfillJob {
  id              BigInt    @id @default(autoincrement())
  account_id      Int       @unique
  status          String    @default("idle") @db.VarChar(16)
  from_date       DateTime? @db.Date
  to_date         DateTime? @db.Date
  checkpoint_date DateTime? @db.Date
  days_total      Int       @default(0)
  days_done       Int       @default(0)
  last_error      String?
  requested_by    String?   @db.VarChar(128)
  started_at      DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
}

