generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

// Note: The `url` property is correct for Prisma 6.x (project uses ^6.1.0)
// Prisma 7+ requires moving this to prisma.config.ts, but this project uses Prisma 6
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Account {
  id                                     Int                             @id(map: "Customer_pkey") @unique(map: "account_id_key") @default(autoincrement())
  created_at                             DateTime                        @default(now()) @db.Timestamptz(6)
  name                                   String?                         @db.VarChar
  address_line1                          String?
  city                                   String?
  postal_code                            String?
  address_line2                          String?
  country_id                             Int?                            @db.SmallInt
  promise_to_pay                         Int                             @default(0) @db.SmallInt
  modified_at                            DateTime                        @default(now()) @db.Timestamptz(6)
  state_id                               Int?
  company_number                         String?
  client_type                            customer_client_type            @default(All)
  sms_from_name                          String?                         @db.VarChar
  status                                 record_status                   @default(Active)
  sub_domain                             String?                         @db.VarChar
  no_of_auomated_steps                   Int                             @default(10) @db.SmallInt
  category_after_automated               category?
  allow_partial_payment                  Boolean                         @default(true)
  bank_comments                          String?
  logo                                   String?
  primary_color                          String?                         @db.VarChar(7)
  secondary_color                        String?                         @db.VarChar(7)
  chart_palette_color                    String?                         @db.VarChar(7)
  default_language                       language?
  start_days_after_due                   Int                             @default(1) @db.SmallInt
  email_from_name                        String?                         @db.VarChar
  email_server_host                      String?                         @db.VarChar
  email_from                             String?                         @db.VarChar
  email_server_user                      String?                         @db.VarChar
  email_server_password                  String?                         @db.VarChar
  email_server_port                      Int?                            @db.SmallInt
  currency                               String?                         @db.VarChar
  wait_days_after_automated              Int                             @default(1) @db.SmallInt
  max_promise_to_pay_allowed_per_cycle   Int?                            @default(0) @db.SmallInt
  locale                                 String?                         @default("en-US") @db.VarChar(10)
  next_activity_date                     DateTime?                       @db.Timestamptz(6)
  beneficiary_name                       String?                         @db.VarChar
  bank_name                              String?                         @db.VarChar
  branch_number                          String?                         @db.VarChar
  branch_name                            String?                         @db.VarChar
  swift                                  String?                         @db.VarChar
  iban                                   String?                         @db.VarChar
  account_number                         String?                         @db.VarChar
  balance_evaluation_method              String?                         @default("Invoice-Based") @db.VarChar
  generic_field_config                   Json?
  use_customer_language                  Boolean?                        @default(true)
  default_first_activity_delay_days      Int?                            @db.SmallInt
  sms_fallback_enabled                   Boolean?                        @default(true)
  unlisted_country_sms_policy            String?                         @default("block") @db.VarChar(20)
  intelligent_channel_selection_enabled  Boolean?                        @default(false)
  category_for_new_collection            category?
  portal_verification_enabled            Boolean?                        @default(true)
  sso_enabled                            Boolean?                        @default(false)
  sso_providers                          String?                         @db.VarChar(100)
  has_collection                         Boolean                         @default(true)
  has_credit_insurance                   Boolean                         @default(false)
  /// When false, File Import is hidden from nav, Import page, and role matrix (UI-only).
  has_file_import                        Boolean                         @default(true)
  enable_customer_checkpoints            Boolean                         @default(false)
  /// AR coverage percentage threshold to include a customer in limit warnings (e.g. 95).
  credit_limit_warning_threshold_pct     Int?                            @db.SmallInt
  /// Number of days before credit-score validity expiry to include customer in warnings.
  credit_score_validity_warning_days     Int?                            @db.SmallInt
  /// Number of days before target reporting date to include invoices in reporting countdown.
  reporting_date_warning_days            Int?                            @db.SmallInt
  /// Number of days before approved_limit_expiration_date to start showing the customer in limit warnings.
  customer_limit_expiration_warning_days Int?                            @db.SmallInt
  created_by                             String?                         @db.VarChar
  modified_by                            String?                         @db.VarChar
  deleted_at                             DateTime?                       @db.Timestamptz(6)
  deleted_by                             String?                         @db.VarChar
  User_Account_created_byToUser          User?                           @relation("Account_created_byToUser", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "AccountCreatedBy_fkey")
  User_Account_modified_byToUser         User?                           @relation("Account_modified_byToUser", fields: [modified_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "AccountModifiedBy_fkey")
  User_Account_deleted_byToUser          User?                           @relation("Account_deleted_byToUser", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "AccountDeletedBy_fkey")
  Country                                Country?                        @relation(fields: [country_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "account_country_id_fkey")
  State                                  State?                          @relation(fields: [state_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "account_state_id_fkey")
  AccountBankAccounts                    AccountBankAccounts[]
  AccountSMSProviderPreferences          AccountSMSProviderPreferences[]
  ActivitiesSequence                     ActivitiesSequence[]
  ActivitiesTemplate                     ActivitiesTemplate[]
  Activity                               Activity[]
  ActivityAttachment                     ActivityAttachment[]
  // ActivityTemplateLanguage relation removed (account_id column dropped from that table)
  BusinessUnitBankAccounts               BusinessUnitBankAccounts[]
  CustomerBanks                          CustomerBanks[]
  DisputeReason                          DisputeReason[]
  // DisputeReasonLanguage relation removed (account_id column dropped from that table)
  ImportJob                              ImportJob[]
  InternalEmailTemplate                  InternalEmailTemplate[]
  Invoice                                Invoice[]
  InvoicePayment                         InvoicePayment[]
  Log                                    Log[]
  Notification                           Notification[]
  NotificationRuleSet                    NotificationRuleSet[]
  NotificationDeliveryLog                NotificationDeliveryLog[]
  SequenceContainer                      SequenceContainer[]
  User_User_account_idToAccount          User[]                          @relation("User_account_idToAccount")
  BusinessUnit                           BusinessUnit[]
  RolePermission                         RolePermission[]                @relation("RolePermission_account_idToAccount")
  Customer                               Customer[]
  InsurancePolicy                        InsurancePolicy[]
  Report                                 Report[]
  BillingConnector                       BillingConnector?
  CustomerCheckpoint                     CustomerCheckpoint[]

  @@index([country_id], map: "idx_account_country_id")
  @@index([country_id, state_id], map: "idx_account_country_state")
  @@index([created_by], map: "idx_account_created_by")
  @@index([modified_by], map: "idx_account_modified_by")
  @@index([deleted_by], map: "idx_account_deleted_by")
  @@index([state_id], map: "idx_account_state_id")
  @@index([status], map: "idx_account_status")
  @@index([status, name], map: "idx_account_status_name")
  @@index([name], map: "idx_name")
  @@index([deleted_at], map: "idx_account_deleted_at")
}

