# Auto-detect text files and perform LF normalization
* text=auto

# Enforce LF for all shell scripts
*.sh text eol=lf

# Enforce CRLF for Windows-specific scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Mark binaries and other files to ignore line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.bz2 binary
*.gz binary
*.zip binary
*.tar.gz binary
