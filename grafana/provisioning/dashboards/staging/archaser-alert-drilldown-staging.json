                {
                    "datasource": {
                        "type": "postgres",
                        "uid": "Postgres"
                    },
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT COALESCE(a.name, 'N/A') AS \"Account Name\", COALESCE(c.customer_number, 'N/A') AS \"Customer Number\", ccp.customer_id AS \"Customer ID\", COALESCE(TO_CHAR(CASE WHEN ccp.next_activity_date IS NULL THEN ccp.period_start_date ELSE ccp.next_activity_date + INTERVAL '24 hours' END, 'YYYY-MM-DD HH24:MI:SS'), 'N/A') AS \"Problem Start Date\", COALESCE(TO_CHAR(ccp.next_activity_date, 'YYYY-MM-DD HH24:MI:SS'), 'N/A') AS \"Next Activity Date\" FROM \"CustomerCollectionPeriod\" ccp JOIN \"Customer\" c ON c.id = ccp.customer_id JOIN \"Account\" a ON a.id = c.account_id WHERE ccp.period_end_date IS NULL AND ccp.current_category = 'Automated' AND (ccp.next_activity_date IS NULL OR ccp.next_activity_date < NOW() - INTERVAL '24 hours') AND NOT EXISTS (SELECT 1 FROM \"Activity\" act INNER JOIN \"ActivitiesSequence\" seq ON seq.id = act.activity_sequence_id WHERE act.collection_period_id = ccp.id AND seq.category = 'Automated' AND act.status = 'SCHEDULED') LIMIT 50",
                    "refId": "A"
                }
            ],
            "title": "Periods Without Activities (Potential Issue)",
            "type": "table"
