            "targets": [
                {
                    "datasource": {
                        "type": "postgres",
                        "uid": "Postgres"
                    },
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT DISTINCT ON (c.id) COALESCE(a.name, 'N/A') AS \"Account Name\", COALESCE(c.customer_number, 'N/A') AS \"Customer Number\", c.id AS \"Customer ID\", COALESCE(c.collection_status::text, 'N/A') AS \"Collection Status\", COALESCE(ccp.id::text, 'N/A') AS \"Open Period ID\", COALESCE(ccp.current_category::text, 'N/A') AS \"Current Category\", COALESCE(c.number_of_overdue_invoices, 0) AS \"# Overdue Invoices\", COALESCE(c.total_invoices_overdue, 0) AS \"Total Overdue (cust curr)\" FROM \"Customer\" c JOIN \"Account\" a ON a.id = c.account_id INNER JOIN \"CustomerCollectionPeriod\" ccp ON ccp.customer_id = c.id AND ccp.period_end_date IS NULL AND ccp.current_category IS NULL WHERE ( COALESCE(c.number_of_overdue_invoices, 0) > 0 OR COALESCE(c.total_invoices_overdue, 0) > 0 OR EXISTS ( SELECT 1 FROM \"Invoice\" i WHERE i.customer_id = c.id AND i.status = 'Overdue' AND COALESCE(i.customer_outstanding_debt, i.outstanding_debt, 0) > 0 ) ) ORDER BY c.id, ccp.period_start_date DESC NULLS LAST LIMIT 50",
                    "refId": "A"
                }
            ],
            "title": "Overdue \u2014 open period category N/A",
            "type": "table",
            "description": "Customers with overdue exposure while the open collection period has no current_category (shown as N/A in the app)."
