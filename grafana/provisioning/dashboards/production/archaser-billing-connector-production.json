      },
      "targets": [
        {
          "datasource": { "type": "haohanyang-mongodb-datasource", "uid": "MongoDB" },
          "refId": "A",
          "collection": "connector_sync_executions",
          "queryLanguage": "json",
          "queryText": "[\n  { \"$match\": { \"status\": { \"$in\": [\"FAILED\", \"PARTIAL\", \"TIMEOUT\"] } } },\n  { \"$sort\": { \"started_at\": -1 } },\n  { \"$limit\": 200 },\n  { \"$project\": {\n    \"_id\": 0,\n    \"started_at\": 1,\n    \"completed_at\": 1,\n    \"account_id\": 1,\n    \"connector_id\": 1,\n    \"provider\": 1,\n    \"trigger\": 1,\n    \"sync_mode\": 1,\n    \"status\": 1,\n    \"error_type\": 1,\n    \"error_message\": 1,\n    \"execution_id\": 1,\n    \"duration_seconds\": 1\n  } }\n]"
        }
      ],
      "title": "Failed / partial / timeout executions (Mongo)",
