            },
            "id": 201,
            "title": "Production Job Statistics (24h)",
            "type": "table",
            "targets": [
                {
                    "expr": "sum by(job_name) (increase(archaser_cron_job_executions_total{instance=\"Production\"}[24h]))",
                    "format": "table",
                    "instant": true,
                    "legendFormat": "Total Executions",
                    "refId": "A"
                },
                {
                    "expr": "sum by(job_name) (increase(archaser_cron_job_executions_total{instance=\"Production\",status=\"SUCCESS\"}[24h]))",
                    "format": "table",
                    "instant": true,
                    "legendFormat": "Success Count",
                    "refId": "B"
                },
                {
                    "expr": "sum by(job_name) (increase(archaser_cron_job_executions_total{instance=\"Production\",status=\"FAILED\"}[24h]))",
                    "format": "table",
                    "instant": true,
                    "legendFormat": "Failure Count",
                    "refId": "C"
                },
                {
                    "expr": "max by(job_name) (archaser_cron_job_duration_seconds{instance=\"Production\"})",
                    "format": "table",
                    "instant": true,
                    "legendFormat": "Duration (s)",
                    "refId": "D"
                },
                {
                    "expr": "max by(job_name) (archaser_cron_job_last_run_timestamp_seconds{instance=\"Production\"}) * 1000",
                    "format": "table",
                    "instant": true,
                    "legendFormat": "Last Run",
                    "refId": "E"
                },
                {
                    "expr": "max by(job_name) (archaser_cron_job_next_run_timestamp_seconds{instance=\"Production\"}) * 1000",
                    "format": "table",
                    "instant": true,
                    "legendFormat": "Next Run",
                    "refId": "F"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "align": "auto",
                        "displayMode": "auto"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Last Run"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "dateTimeFromNow"
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Next Run"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "dateTimeFromNow"
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Failures"
                        },
                        "properties": [
                            {
                                "id": "custom.displayMode",
                                "value": "color-background"
                            },
                            {
                                "id": "thresholds",
                                "value": {
                                    "mode": "absolute",
                                    "steps": [
                                        {
                                            "color": "green",
                                            "value": null
                                        },
                                        {
                                            "color": "red",
                                            "value": 1
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                ]
            },
            "transformations": [
                {
                    "id": "joinByField",
                    "options": {
                        "byField": "job_name",
                        "mode": "outer"
                    }
                },
                {
                    "id": "organize",
                    "options": {
                        "excludeByName": {
                            "Time": true
                        },
                        "indexByName": {
                            "job_name": 0,
                            "Value #A": 1,
                            "Value #B": 2,
                            "Value #C": 3,
                            "Value #D": 4,
                            "Value #E": 5,
                            "Value #F": 6
                        },
                        "renameByName": {
                            "Value #A": "Total Runs (24h)",
                            "Value #B": "Successes",
                            "Value #C": "Failures",
                            "Value #D": "Duration (s)",
                            "Value #E": "Last Run",
                            "Value #F": "Next Run"
                        }
                    }
                }
            ]
