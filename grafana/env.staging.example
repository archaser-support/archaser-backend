# Staging monitoring — copy into backend/.env (or .env.staging) on the API EC2.
# Used by: docker compose --env-file ../.env -f docker-compose.logging.yml up -d

MONITORING_ENV=staging
GRAFANA_ROOT_URL=https://grafana.staging.archaser.com/
GRAFANA_DOMAIN=grafana.staging.archaser.com
# Host port for Grafana UI (Nest owns 3002–3006 / api 3010)
GRAFANA_HOST_PORT=3200

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Grafana metadata DB (compose service grafana-db)
GRAFANA_INTERNAL_DB_USER=postgres
GRAFANA_INTERNAL_DB_PASSWORD=change-me
GRAFANA_INTERNAL_DB_NAME=grafana_internal

# App Postgres datasource (reachable from Grafana container)
GRAFANA_DB_HOST=host.docker.internal
GRAFANA_DB_PORT=5432
GRAFANA_DB_NAME=archaser
GRAFANA_DB_USER=postgres
GRAFANA_DB_PASSWORD=change-me
GRAFANA_DB_SSLMODE=require

# SMTP (optional; leave empty / GF_SMTP_ENABLED=false if unused)
GF_SMTP_ENABLED=false
# GRAFANA_SMTP_HOST=
# GRAFANA_SMTP_USER=
# GRAFANA_SMTP_PASSWORD=
# GRAFANA_SMTP_FROM=

# Host apps → Loki
ENABLE_LOKI_LOGGING=true
LOKI_HOST=http://localhost:3100
