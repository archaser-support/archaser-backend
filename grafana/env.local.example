# Copy to .env.local (gitignored) for laptop monitoring via Podman:
#   cp env.local.example .env.local
#   podman network create archaser-backend-local   # once
#   podman-compose --project-name archaser-monitoring-local \
#     --env-file .env.local \
#     -f docker-compose.logging.yml -f docker-compose.local.yml up -d
#
# UI: http://localhost:3200  (admin / admin)
# Prometheus: http://127.0.0.1:9090

MONITORING_ENV=staging
GRAFANA_ROOT_URL=http://localhost:3200/
GRAFANA_DOMAIN=localhost
GRAFANA_HOST_PORT=3200

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

GRAFANA_INTERNAL_DB_USER=postgres
GRAFANA_INTERNAL_DB_PASSWORD=postgres
GRAFANA_INTERNAL_DB_NAME=grafana_internal

GRAFANA_DB_HOST=host.containers.internal
GRAFANA_DB_PORT=5432
GRAFANA_DB_NAME=archaser
GRAFANA_DB_USER=postgres
GRAFANA_DB_PASSWORD=postgres
GRAFANA_DB_SSLMODE=disable

# Required non-empty for Grafana alerting provisioning
GRAFANA_SNS_WEBHOOK_URL=http://127.0.0.1:9

GF_SMTP_ENABLED=false
ENABLE_LOKI_LOGGING=false
LOKI_HOST=http://loki:3100
BACKEND_DOCKER_NETWORK=archaser-backend-local
PM2_LOGS_HOST_PATH=/tmp
