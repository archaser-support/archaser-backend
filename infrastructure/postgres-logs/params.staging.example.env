# Copy to params.staging.env and fill in staging values (slice 4 fast-follow).
# Example values below match the current eu-north-1 staging layout (shared RDS).

ENVIRONMENT=staging
AWS_REGION=eu-north-1

# Slice 1
RDS_INSTANCE_ID=archaser-db-encrypted
FAMILY=postgres17
# Use stderr until jsonlog is applied and the instance is rebooted in a maintenance window
LOG_DESTINATION=stderr
SLOW_QUERY_MS=1000
RETENTION_DAYS=5
APPLY_IMMEDIATELY=false

# Slice 2
WRITE_ADDRESS=http://172.31.5.228:3100/loki/api/v1/push
RDS_LOG_GROUP=/aws/rds/instance/archaser-db-encrypted/postgresql
VPC_ID=vpc-0099390c7c6f6bcb4
# Default VPC has no private subnets — use existing subnets; Lambda ENIs stay without public IPs.
# Pair with a CloudWatch Logs VPC interface endpoint (no NAT required).
PRIVATE_SUBNET_IDS=subnet-0f8e11998c2e7feeb,subnet-0b0f125ac32e5f6e5
LOKI_SECURITY_GROUP_ID=sg-0d1c18c2cf82dcfa3
S3_BUCKET=archaser-storage
S3_KEY=lambda-promtail/lambda-promtail-v1.0.0.zip

# stderr severity extraction (required while LOG_DESTINATION=stderr)
LOKI_STAGE_CONFIGS='[{"regex":{"expression":"(?P<error_severity>DEBUG|INFO|NOTICE|WARNING|ERROR|FATAL|PANIC|LOG):"}},{"labels":{"error_severity":""}}]'
