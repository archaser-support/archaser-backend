# Copy to params.staging.env and fill in staging values (slice 4 fast-follow).

ENVIRONMENT=staging
AWS_REGION=eu-north-1

# Slice 1 (staging)
RDS_INSTANCE_ID=REPLACE_WITH_STAGING_RDS_ID
FAMILY=postgres16
LOG_DESTINATION=jsonlog
SLOW_QUERY_MS=1000
RETENTION_DAYS=5
APPLY_IMMEDIATELY=false

# Slice 2 (staging stack — separate stack name via ENVIRONMENT)
WRITE_ADDRESS=http://REPLACE_WITH_STAGING_EC2_PRIVATE_IP:3100/loki/api/v1/push
RDS_LOG_GROUP=/aws/rds/instance/REPLACE_WITH_STAGING_RDS_ID/postgresql
VPC_ID=vpc-REPLACE
PRIVATE_SUBNET_IDS=subnet-REPLACE_A,subnet-REPLACE_B
LOKI_SECURITY_GROUP_ID=sg-REPLACE
S3_BUCKET=REPLACE_WITH_DEPLOY_ARTIFACTS_BUCKET
S3_KEY=lambda-promtail/lambda-promtail-v1.0.0.zip
